{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug (STLink)",
      "type": "cortex-debug",
      "serverpath": "openocd",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/light_on.elf",
      "preLaunchTask": "cmake-build-debug",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "runToEntryPoint": "main",
      "device": "STM32F407IGHx",
      "liveWatch": { "enabled": true, "samplesPerSecond": 20 }
    },
    {
      "name": "STM32 Debug (DAP)",
      "type": "cortex-debug",
      "serverpath": "openocd",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/light_on.elf",
      "preLaunchTask": "cmake-build-debug",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f4x.cfg"
      ],
      "runToEntryPoint": "main",
      "device": "STM32F407IGHx",
      "liveWatch": { "enabled": true, "samplesPerSecond": 20 }
    }
  ]
}
